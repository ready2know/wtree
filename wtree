#!/bin/bash

# Git worktree helper for the bare-repo layout.
#
#   wtree init <owner>/<repository>          Bare-clone a repo into the current (empty) directory
#   wtree add <worktree> [-c <branch>]       Add a worktree + branch, then run the post-add hook
#   wtree remove <worktree> [-f]             Remove a worktree and delete its local branch
#   wtree ls | list                          List worktrees with status
#   wtree sync [<worktree>]                  Fast-forward one worktree, or all of them
#   wtree sweep | clean                      Remove merged / dead worktrees
#   wtree path [<worktree>]                  Print the path to a worktree (or the repo root)
#   wtree editor [<worktree>]                Open a worktree in the IDE ($WTREE_EDITOR, default webstorm)
#   wtree run <worktree> <command...>        Run a command with the worktree as its working directory
#   wtree agent <worktree> [args...]         Start the coding agent inside a worktree ($WTREE_AGENT, default claude)
#   wtree herdr-agent <worktree> [-n <name>] [--down|--right]
#                                            Start a named herdr agent on a worktree: in a split, else a
#                                            free pane in this tab, else the current pane
#   wtree prune                              Prune stale worktree metadata
#
# Hooks live in <repo-root>/.wtree/config.json and need jq. See run_hooks().

SCRIPT_NAME=$(basename "$0")

# stdout stays machine-readable when a command is used for its output (e.g. add -p)
QUIET_STDOUT=0

# Defaults for the agent commands; set either to "" to pass no such flag at all
WTREE_MODEL=${WTREE_MODEL:-opus}
WTREE_EFFORT=${WTREE_EFFORT:-xhigh}

if [ -t 1 ]; then
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_YEL=$'\033[33m'
    C_GRN=$'\033[32m'
    C_CYN=$'\033[36m'
    C_OFF=$'\033[0m'
else
    C_DIM=""
    C_RED=""
    C_YEL=""
    C_GRN=""
    C_CYN=""
    C_OFF=""
fi

# Pad to a width in characters. Done before colouring, so escape codes never skew a column.
pad() {
    local s=$1 n=$(($2 - ${#1})) sp=''
    [ "$n" -gt 0 ] && printf -v sp '%*s' "$n" ''
    printf '%s%s' "$s" "$sp"
}

# Seconds as something readable. Whole seconds is all $SECONDS offers, and it is
# the only clock bash 3.2 has without spawning a process per measurement.
fmt_duration() {
    local s=$1
    if [ "$s" -lt 1 ]; then
        printf '<1s'
    elif [ "$s" -lt 60 ]; then
        printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then
        printf '%dm %02ds' "$((s / 60))" "$((s % 60))"
    else
        printf '%dh %02dm %02ds' "$((s / 3600))" "$(((s % 3600) / 60))" "$((s % 60))"
    fi
}

# has_arg <flag> <args...> - is <flag> (or <flag>=value) already in the args?
has_arg() {
    local flag=$1 a
    shift
    for a in "$@"; do
        case "$a" in "$flag" | "$flag"=*) return 0 ;; esac
    done
    return 1
}

colour_of() {
    case "$1" in
        red) printf '%s' "$C_RED" ;;
        yellow) printf '%s' "$C_YEL" ;;
        green) printf '%s' "$C_GRN" ;;
        cyan) printf '%s' "$C_CYN" ;;
        *) printf '%s' "$C_DIM" ;;
    esac
}

# Ahead is cyan, behind is yellow - a diverged cell shows both at once
render_sync() {
    case "$1" in
        ahead) printf '%s%s%s' "$C_CYN" "$2" "$C_OFF" ;;
        behind) printf '%s%s%s' "$C_YEL" "$2" "$C_OFF" ;;
        diverged) printf '%s%s%s %s%s%s' "$C_CYN" "${2%% *}" "$C_OFF" "$C_YEL" "${2##* }" "$C_OFF" ;;
        *) printf '%s%s%s' "$(colour_of "$1")" "$2" "$C_OFF" ;;
    esac
}

usage() {
    cat <<EOF
