}

say() {
    if [ "$QUIET_STDOUT" -eq 1 ]; then
        echo "$@" >&2
    else
        echo "$@"
    fi
}

# say() with printf formatting. Built into a string first so it still goes
# through say(), keeping stdout clean when it is being captured.
sayf() {
    local fmt=$1 out
    shift
    # shellcheck disable=SC2059
    printf -v out "$fmt" "$@"
    say "$out"
}

die() {
    echo "❌ Error: $1" >&2
    shift
    for line in "$@"; do
        echo "$line" >&2
    done
    exit 1
}

require_repo() {
    if ! git rev-parse --git-common-dir >/dev/null 2>&1; then
        die "Not inside a git repository." \
            "Run '$SCRIPT_NAME init <owner>/<repository>' in an empty directory first."
    fi
}

# Root of the worktree setup: the directory holding .bare (or .git)
repo_root() {
    local common
    common=$(git rev-parse --git-common-dir) || return 1
    case "$common" in
        /*) ;;
        *) common="$PWD/$common" ;;
    esac
    (cd "$(dirname "$common")" && pwd)
}

# <worktree> -> path. Absolute paths are used as-is, names are placed next to .bare
worktree_path() {
    local name=$1
    case "$name" in
        /*) echo "$name" ;;
        *) echo "$(repo_root)/${name%/}" ;;
    esac
}

# <worktree> -> branch name. "feature/login" stays a nested dir + slashed branch
worktree_branch() {
    local name=$1
    case "$name" in
        /*) basename "$name" ;;
        *) echo "${name%/}" ;;
    esac
}

default_branch() {
    local ref b
    ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)
    if [ -n "$ref" ]; then
        echo "${ref#refs/remotes/origin/}"
        return 0
    fi
    for b in main master; do
        if git show-ref --verify --quiet "refs/remotes/origin/$b" ||
            git show-ref --verify --quiet "refs/heads/$b"; then
            echo "$b"
            return 0
        fi
    done
    return 1
}

# Prefer the remote-tracking ref so worktrees start from the freshest commit
resolve_base() {
    local branch=$1
    if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        echo "origin/$branch"
    elif git show-ref --verify --quiet "refs/heads/$branch"; then
        echo "$branch"
    else
        return 1
    fi
}

# Emit "<path>\t<branch>" per worktree; the bare repo entry is skipped
list_worktrees() {
    local path="" branch="" bare=0 line
    while IFS= read -r line; do
        case "$line" in
            "worktree "*)
                path=${line#worktree }
                branch=""
                bare=0
                ;;
            "branch "*)
                branch=${line#branch }
                branch=${branch#refs/heads/}
                ;;
            "bare") bare=1 ;;
            "detached") branch="" ;;
            "")
                if [ -n "$path" ] && [ "$bare" -eq 0 ]; then
                    printf '%s\t%s\n' "$path" "$branch"
                fi
                path=""
                branch=""
                bare=0
                ;;
        esac
    done < <(git worktree list --porcelain)
    if [ -n "$path" ] && [ "$bare" -eq 0 ]; then
        printf '%s\t%s\n' "$path" "$branch"
    fi
}

# The remote branch we were tracking has been deleted
upstream_gone() {
    local dir=$1 branch=$2
    [ -n "$branch" ] || return 1
    git -C "$dir" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 && return 1
    [ -n "$(git -C "$dir" config --get "branch.$branch.merge")" ]
}

# Prints "<colour-key>\t<text>" so the caller can pad the text before colouring it
sync_label() {
    local dir=$1 branch=$2 counts behind ahead out=""
    if [ -z "$branch" ]; then
        printf 'dim\tdetached\n'
        return
    fi
    if ! git -C "$dir" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
        if upstream_gone "$dir" "$branch"; then
            printf 'red\tupstream gone\n'
        else
            printf 'dim\tno upstream\n'
        fi
        return
    fi
    counts=$(git -C "$dir" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null) || {
        printf 'dim\t-\n'
        return
    }
    behind=${counts%%[[:space:]]*}
    ahead=${counts##*[[:space:]]}
    [ "$ahead" -gt 0 ] 2>/dev/null && out="↑$ahead"
    [ "$behind" -gt 0 ] 2>/dev/null && out="${out:+$out }↓$behind"
    if [ -z "$out" ]; then
        printf 'dim\tup to date\n'
    elif [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
        printf 'diverged\t%s\n' "$out"
    elif [ "$ahead" -gt 0 ]; then
        printf 'ahead\t%s\n' "$out"
    else
        printf 'behind\t%s\n' "$out"
    fi
}

# Every event a .wtree/config.json may define, so a typo can be pointed at
HOOK_EVENTS="pre-add post-add"

# The scaffold 'init' leaves behind: the shape of the file, with nothing in it
hook_config_template() {
    cat <<'EOF'
{
  "hooks": {
    "pre-add": {
      "actions": []
    },
    "post-add": {
      "actions": []
    }
  }
}
EOF
}

# One action, in a subshell of its own, so both its cd and the exported context
# die with it and the next action starts from a clean slate
hook_run_action() {
    (
        cd "$1" || exit 1
        export WTREE_EVENT WTREE_NAME WTREE_BRANCH WTREE_PATH WTREE_ROOT
        exec bash -c "$2"
    )
}

# A command rendered as one trimmed line, for the progress column
hook_label() {
    local s=${1%%$'\n'*} more=""
    [ "$s" != "$1" ] && more=" …"
    s=${s#"${s%%[![:space:]]*}"}
    s=${s%"${s##*[![:space:]]}"}
    [ ${#s} -gt 72 ] && s="${s:0:71}…"
    printf '%s%s' "$s" "$more"
}

# A hook nobody ever runs looks exactly like a hook that passed, so name typos
# are worth a word
hook_warn_unknown() {
    local cfg=$1 key
    while IFS= read -r key; do
        case " $HOOK_EVENTS " in
            *" $key "*) ;;
            *) echo "⚠️  $cfg: unknown hook '$key' (known: $HOOK_EVENTS)" >&2 ;;
        esac
    done < <(jq -r '.hooks | if type == "object" then keys[] else empty end' "$cfg" 2>/dev/null)
}

# run_hooks <event> <cwd> <name> <branch> <worktree-path>
#
# Actions run in order, each in its own subshell rooted at <cwd>, so a 'cd' in
# one never leaks into the next - every command starts from the same place. The
# worktree does not exist yet during pre-add, which is why the caller picks the
# directory rather than this function assuming one.
#
# A failing action is recorded and the remaining ones still run, so one broken
# step can neither skip the rest of the setup nor hide a second problem behind
# the first; the failures are listed at the end.
#
# Returns 0 when everything passed or there was nothing to do, 1 when an action
# failed, and 2 when the config itself could not be read. The caller needs those
# apart: a failed action gates 'add', a missing jq should not.
run_hooks() {
    local event=$1 cwd=$2 name=$3 branch=$4 path=$5
    local root cfg count i n action_type cmd label rc
    local started t0 dur indent
    local -a failed=()

    root=$(repo_root) || return 0
    cfg="$root/.wtree/config.json"
    [ -f "$cfg" ] || return 0

    if ! command -v jq >/dev/null 2>&1; then
        echo "⚠️  $cfg exists but jq is not installed - skipping hooks." >&2
        echo "   Install jq to run them." >&2
        return 2
    fi

    if ! jq -e 'type == "object"' "$cfg" >/dev/null 2>&1; then
        echo "⚠️  $cfg is not a JSON object - skipping hooks." >&2
        jq '.' "$cfg" >/dev/null # jq reports its own parse error, if that is the problem
        return 2
    fi

    hook_warn_unknown "$cfg"

    count=$(jq --arg e "$event" '.hooks[$e].actions | if type == "array" then length else 0 end' "$cfg")
    [ "${count:-0}" -gt 0 ] 2>/dev/null || return 0

    # Timing lines sit under the command they belong to, so the "[n/count] "
    # prefix is padded to a fixed width and matched by an indent of the same size
    printf -v indent '%*s' "$((2 * ${#count} + 6))" ''

    # Plain shell variables here, exported only inside each action's subshell, so
    # nothing leaks into the git commands wtree runs around the hook
    WTREE_EVENT=$event
    WTREE_NAME=$name
    WTREE_BRANCH=$branch
    WTREE_PATH=$path
    WTREE_ROOT=$root

    started=$SECONDS
    sayf '\n🪝 %s - running %d action(s) in %s' "$event" "$count" "$cwd"

    for ((i = 0; i < count; i++)); do
        n=$((i + 1))
        action_type=$(jq -r --arg e "$event" --argjson i "$i" '.hooks[$e].actions[$i].type // "bash"' "$cfg")
        cmd=$(jq -r --arg e "$event" --argjson i "$i" '.hooks[$e].actions[$i].command // ""' "$cfg")

        if [ "$action_type" != "bash" ]; then
            sayf '  %s[%*d/%d]%s %sunsupported action type: %s%s' \
                "$C_DIM" "${#count}" "$n" "$count" "$C_OFF" "$C_RED" "$action_type" "$C_OFF"
            failed+=("[$n] unsupported action type '$action_type'")
            continue
        fi
        if [ -z "$cmd" ]; then
            sayf '  %s[%*d/%d]%s %saction has no command%s' \
                "$C_DIM" "${#count}" "$n" "$count" "$C_OFF" "$C_RED" "$C_OFF"
            failed+=("[$n] action has no command")
            continue
        fi

        label=$(hook_label "$cmd")
        sayf '  %s[%*d/%d]%s %s' "$C_DIM" "${#count}" "$n" "$count" "$C_OFF" "$label"

        t0=$SECONDS
        # With -p the caller is capturing stdout, so an action's own output
        # must not land there either
        if [ "$QUIET_STDOUT" -eq 1 ]; then
            hook_run_action "$cwd" "$cmd" >&2
        else
            hook_run_action "$cwd" "$cmd"
        fi
        rc=$?
        dur=$((SECONDS - t0))

        if [ "$rc" -eq 0 ]; then
            sayf '%s%s✔ %s%s' "$indent" "$C_DIM" "$(fmt_duration "$dur")" "$C_OFF"
        else
            sayf '%s%s✘ exit %d%s %s(%s)%s' \
                "$indent" "$C_RED" "$rc" "$C_OFF" "$C_DIM" "$(fmt_duration "$dur")" "$C_OFF"
            failed+=("[$n] exit $rc after $(fmt_duration "$dur") - $label")
        fi
    done

    dur=$((SECONDS - started))

    if [ ${#failed[@]} -eq 0 ]; then
        sayf '%s✅ %s: %d action(s) in %s%s' \
            "$C_GRN" "$event" "$count" "$(fmt_duration "$dur")" "$C_OFF"
        return 0
    fi

    sayf '%s⚠️  %s: %d of %d action(s) failed, %s total:%s' \
        "$C_YEL" "$event" "${#failed[@]}" "$count" "$(fmt_duration "$dur")" "$C_OFF"
    for i in "${!failed[@]}"; do
        sayf '     %s' "${failed[$i]}"
    done
    return 1
}

cmd_init() {
    local repo=$1 url files
    [ -z "$repo" ] && die "Missing repository." "Usage: $SCRIPT_NAME init <owner>/<repository>"

    case "$repo" in
        *://* | *@*:*) url=$repo ;;
        */*) url="git@github.com:${repo%.git}.git" ;;
        *) die "Invalid repository '$repo'." "Expected <owner>/<repository> or a full git URL." ;;
    esac

    # Keep the setup clean: only allow this in an empty directory (the script itself may live here)
    files=$(ls -A | grep -v "^$SCRIPT_NAME$")
    if [ -n "$files" ]; then
        die "Current directory is not empty!" \
            "To keep your worktree setup clean, please run this in a fresh folder."
    fi

    echo "🚀 Initializing Git Worktree setup for $url..."

    git clone --bare "$url" .bare || die "Clone failed."

    # Link the root to the bare repository
    echo "gitdir: ./.bare" >.git

    # Enable remote tracking so 'git fetch' sees all branches from the server
    git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

    git fetch --all
    git remote set-head origin --auto >/dev/null 2>&1

    # An empty hook list is far easier to extend than a file you have to know
    # exists before you can write it
    if [ ! -e .wtree/config.json ]; then
        mkdir -p .wtree
        hook_config_template >.wtree/config.json
        echo "🪝 Wrote .wtree/config.json - fill in the hooks to set new worktrees up"
    fi

    echo "✅ Setup complete!"
    echo "Next step: $SCRIPT_NAME add $(default_branch || echo main)"
}

cmd_add() {
    local name="" base="" print_path=0 hooks=1 hooks_rc=0 path branch start root rc

    while [ $# -gt 0 ]; do
        case "$1" in
            -c | --custom-branch)
                [ -z "$2" ] && die "$1 requires a branch name."
                base=$2
                shift 2
                ;;
            -p | --print-path)
                print_path=1
                QUIET_STDOUT=1
                shift
                ;;
            --no-hooks)
                hooks=0
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for add." ;;
            *)
                [ -n "$name" ] && die "Unexpected argument '$1'."
                name=$1
                shift
                ;;
        esac
    done

    [ -z "$name" ] && die "Missing worktree name." "Usage: $SCRIPT_NAME add <worktree> [-c <branch>]"
    require_repo

    path=$(worktree_path "$name")
    branch=$(worktree_branch "$name")
    root=$(repo_root)

    # Before wtree does anything of its own, so a gate that says no costs nothing.
    # Only a failed action stops us - an unreadable config (rc 2) is the user's
    # problem to fix, not a reason to refuse them a worktree.
    if [ "$hooks" -eq 1 ]; then
        run_hooks pre-add "$root" "$name" "$branch" "$path"
        rc=$?
        [ "$rc" -eq 1 ] && die "pre-add hook failed - worktree not created." \
            "Fix the actions above, or re-run with --no-hooks to skip them."
    fi

    say "📡 Fetching latest refs..."
    git fetch origin --quiet || say "⚠️  Fetch failed, continuing with local refs."

    if git show-ref --verify --quiet "refs/heads/$branch"; then
        # Branch already exists locally (e.g. cloned by 'init'), just check it out
        [ -n "$base" ] && say "⚠️  Branch '$branch' already exists, ignoring -c $base."
        say "🌱 Checking out existing branch '$branch'"
        git_wt_add "$path" "$branch" || exit 1
        # 'clone --bare' copies every remote head into refs/heads with no tracking info,
        # which would leave ls/sync/sweep blind. Wire it up the first time we check it out.
        if [ -z "$(git config --get "branch.$branch.merge")" ] &&
            git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
            git -C "$path" branch --quiet --set-upstream-to="origin/$branch" "$branch" 2>/dev/null &&
                say "🔗 Now tracking origin/$branch"
        fi
    elif [ -z "$base" ] && git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        # Someone else's branch: track it instead of forking a same-named branch off main
        say "🌱 Tracking origin/$branch"
        git_wt_add --track -b "$branch" "$path" "origin/$branch" || exit 1
    else
        if [ -z "$base" ]; then
            base=$(default_branch) || die "Could not find a default branch (main/master)." \
                "Pass one explicitly: $SCRIPT_NAME add $name -c <branch>"
        fi
        start=$(resolve_base "$base") || die "Base branch '$base' not found locally or on origin."
        # --no-track: branching off origin/main shouldn't leave you tracking main
        say "🌱 Creating branch '$branch' from $start"
        git_wt_add --no-track -b "$branch" "$path" "$start" || exit 1
    fi

    say "✅ Worktree ready: $path"

    # The worktree exists either way - a failing hook is reported, never undone
    [ "$hooks" -eq 1 ] && { run_hooks post-add "$path" "$name" "$branch" "$path" || hooks_rc=1; }

    [ "$print_path" -eq 1 ] && echo "$path"
    return "$hooks_rc"
}

git_wt_add() {
    if [ "$QUIET_STDOUT" -eq 1 ]; then
        git worktree add "$@" >&2
    else
        git worktree add "$@"
    fi
}

cmd_remove() {
    local name="" force=0 path branch delete_flag

    while [ $# -gt 0 ]; do
        case "$1" in
            -f | --force)
                force=1
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for remove." ;;
            *)
                [ -n "$name" ] && die "Unexpected argument '$1'."
                name=$1
                shift
                ;;
        esac
    done

    [ -z "$name" ] && die "Missing worktree name." "Usage: $SCRIPT_NAME remove <worktree>"
    require_repo

    path=$(worktree_path "$name")
    [ -d "$path" ] || die "No such worktree: $path"

    # Ask the worktree itself which branch it has checked out
    branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null)

    echo "🗑  Removing worktree $path"
    if [ "$force" -eq 1 ]; then
        git worktree remove --force "$path" || exit 1
    else
        git worktree remove "$path" || die "Worktree removal failed." \
            "It may have uncommitted changes - re-run with -f to force."
    fi

    if [ -z "$branch" ]; then
        echo "⚠️  Worktree was in detached HEAD, no branch to delete."
    else
        delete_flag="-d"
        [ "$force" -eq 1 ] && delete_flag="-D"
        if git branch "$delete_flag" "$branch"; then
            echo "✅ Removed worktree and branch '$branch'."
        else
            echo "⚠️  Kept branch '$branch' (not fully merged). Delete it with: git branch -D $branch"
        fi
    fi
}

cmd_list() {
    require_repo

    # Raw git output when the user asks for it (--porcelain, -v, ...)
    if [ $# -gt 0 ]; then
        git worktree list "$@"
        return
    fi

    local root current path branch name state state_key sync sync_key pair hdr rule total i
    local -a r_mark=() r_name=() r_branch=() r_state=() r_statek=() r_sync=() r_synck=()
    local w_name=4 w_branch=6 w_state=5 w_sync=4 # start at the header widths

    root=$(repo_root)
    current=$(git rev-parse --show-toplevel 2>/dev/null)

    # First pass: collect every cell, remembering the widest string per column
    while IFS=$'\t' read -r path branch; do
        name=$path
        case "$path" in "$root"/*) name=${path#"$root"/} ;; esac

        if [ ! -d "$path" ]; then
            state="missing"
            state_key="red"
            sync="run '$SCRIPT_NAME prune'"
            sync_key="red"
        else
            if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
                state="dirty"
                state_key="yellow"
            else
                state="clean"
                state_key="green"
            fi
            pair=$(sync_label "$path" "$branch")
            sync_key=${pair%%$'\t'*}
            sync=${pair#*$'\t'}
        fi
        [ -z "$branch" ] && branch="(detached)"

        if [ "$path" = "$current" ]; then
            r_mark+=("${C_GRN}*${C_OFF}")
        else
            r_mark+=(" ")
        fi
        r_name+=("$name")
        r_branch+=("$branch")
        r_state+=("$state")
        r_statek+=("$state_key")
        r_sync+=("$sync")
        r_synck+=("$sync_key")

        [ ${#name} -gt "$w_name" ] && w_name=${#name}
        [ ${#branch} -gt "$w_branch" ] && w_branch=${#branch}
        [ ${#state} -gt "$w_state" ] && w_state=${#state}
        [ ${#sync} -gt "$w_sync" ] && w_sync=${#sync}
    done < <(list_worktrees)

    echo "🌳 $root"
    echo
    if [ ${#r_name[@]} -eq 0 ]; then
        echo "  (no worktrees yet - create one with: $SCRIPT_NAME add $(default_branch || echo main))"
        return
    fi

    hdr="  $(pad NAME "$w_name")  $(pad BRANCH "$w_branch")  $(pad STATE "$w_state")  SYNC"
    total=$((2 + w_name + 2 + w_branch + 2 + w_state + 2 + w_sync))
    printf -v rule '%*s' "$total" ''
    rule=${rule// /─}

    printf '%s%s%s\n' "$C_DIM" "$hdr" "$C_OFF"
    printf '%s%s%s\n' "$C_DIM" "$rule" "$C_OFF"
    for i in "${!r_name[@]}"; do
        printf '%s %s  %s  %s  %s\n' \
            "${r_mark[$i]}" \
            "$(pad "${r_name[$i]}" "$w_name")" \
            "${C_DIM}$(pad "${r_branch[$i]}" "$w_branch")${C_OFF}" \
            "$(colour_of "${r_statek[$i]}")$(pad "${r_state[$i]}" "$w_state")${C_OFF}" \
            "$(render_sync "${r_synck[$i]}" "${r_sync[$i]}")"
    done
    echo
    printf '%s  * current   %s%s↑%s%s ahead   %s%s↓%s%s behind%s\n' \
        "$C_DIM" "$C_OFF" "$C_CYN" "$C_OFF" "$C_DIM" "$C_OFF" "$C_YEL" "$C_OFF" "$C_DIM" "$C_OFF"
}

# sync_one <path> <display-name> <rebase> <name-width> -> one status line; 1 on a real failure
sync_one() {
    local path=$1 name=$2 rebase=$3 width=$4 branch counts behind ahead out col
    col=$(pad "$name" "$width")

    branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [ -z "$branch" ]; then
        printf '  %s %s\n' "$col" "${C_DIM}detached, skipped${C_OFF}"
        return 0
    fi

    if ! git -C "$path" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
        if upstream_gone "$path" "$branch"; then
            printf '  %s %s\n' "$col" "${C_RED}upstream gone, skipped${C_OFF}"
        else
            printf '  %s %s\n' "$col" "${C_DIM}no upstream, skipped${C_OFF}"
        fi
        return 0
    fi

    counts=$(git -C "$path" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null) || counts="0 0"
    behind=${counts%%[[:space:]]*}
    ahead=${counts##*[[:space:]]}

    if [ "$behind" -eq 0 ]; then
        if [ "$ahead" -gt 0 ]; then
            printf '  %s %s\n' "$col" "${C_DIM}up to date${C_OFF} ${C_CYN}↑$ahead${C_OFF}"
        else
            printf '  %s %s\n' "$col" "${C_DIM}up to date${C_OFF}"
        fi
        return 0
    fi

    if [ "$ahead" -eq 0 ]; then
        # Nothing local to preserve: a fast-forward can never lose work
        if out=$(git -C "$path" merge --ff-only '@{upstream}' 2>&1); then
            printf '  %s %s\n' "$col" "${C_GRN}fast-forwarded ↓$behind${C_OFF}"
            return 0
        fi
        printf '  %s %s\n' "$col" "${C_RED}failed:${C_OFF} ${out%%$'\n'*}"
        return 1
    fi

    if [ "$rebase" -eq 1 ]; then
        if out=$(git -C "$path" rebase '@{upstream}' 2>&1); then
            printf '  %s %s\n' "$col" "${C_GRN}rebased ↑$ahead onto ↓$behind${C_OFF}"
            return 0
        fi
        # Never leave a half-rebased worktree behind, especially mid-sweep of many
        git -C "$path" rebase --abort >/dev/null 2>&1
        printf '  %s %s\n' "$col" "${C_RED}rebase conflicts, aborted${C_OFF} ${C_DIM}- resolve by hand${C_OFF}"
        return 1
    fi

    printf '  %s %s\n' "$col" \
        "diverged ${C_CYN}↑$ahead${C_OFF} ${C_YEL}↓$behind${C_OFF} ${C_DIM}- skipped, use -r to rebase${C_OFF}"
    return 0
}

cmd_sync() {
    local name="" rebase=0 root path branch disp count=0 failures=0 width=4

    while [ $# -gt 0 ]; do
        case "$1" in
            -r | --rebase)
                rebase=1
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for sync." ;;
            *)
                [ -n "$name" ] && die "Unexpected argument '$1'."
                name=$1
                shift
                ;;
        esac
    done
    require_repo

    root=$(repo_root)
    echo "📡 Fetching origin (with --prune)..."
    git fetch origin --prune --quiet || echo "⚠️  Fetch failed, working from local refs."
    echo

    if [ -n "$name" ]; then
        path=$(worktree_path "$name")
        [ -d "$path" ] || die "No such worktree: $path"
        disp=${name%/}
        sync_one "$path" "$disp" "$rebase" "${#disp}" || failures=1
    else
        # Size the name column to the widest worktree before printing anything
        while IFS=$'\t' read -r path branch; do
            disp=$path
            case "$path" in "$root"/*) disp=${path#"$root"/} ;; esac
            [ ${#disp} -gt "$width" ] && width=${#disp}
        done < <(list_worktrees)

        while IFS=$'\t' read -r path branch; do
            count=$((count + 1))
            disp=$path
            case "$path" in "$root"/*) disp=${path#"$root"/} ;; esac
            if [ ! -d "$path" ]; then
                printf '  %s %s\n' "$(pad "$disp" "$width")" \
                    "${C_RED}missing - run '$SCRIPT_NAME prune'${C_OFF}"
                continue
            fi
            sync_one "$path" "$disp" "$rebase" "$width" || failures=1
        done < <(list_worktrees)
        [ "$count" -eq 0 ] && echo "  (no worktrees yet)"
    fi

    [ "$failures" -eq 0 ]
}

cmd_sweep() {
    local dry=0 yes=0 force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -n | --dry-run)
                dry=1
                shift
                ;;
            -y | --yes)
                yes=1
                shift
                ;;
            -f | --force)
                force=1
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            *) die "Unknown option '$1' for sweep." ;;
        esac
    done
    require_repo

    local root current def defref path branch name reason unique answer i
    local -a paths=() branches=() reasons=() skipped=()

    root=$(repo_root)
    current=$(git rev-parse --show-toplevel 2>/dev/null)
    def=$(default_branch) || die "Could not find a default branch (main/master)."

    echo "📡 Fetching origin (with --prune)..."
    git fetch origin --prune --quiet || echo "⚠️  Fetch failed, judging by local refs only."
    defref=$(resolve_base "$def") || die "Default branch '$def' not found."

    while IFS=$'\t' read -r path branch; do
        name=$path
        case "$path" in "$root"/*) name=${path#"$root"/} ;; esac

        [ -z "$branch" ] && continue        # detached HEAD: not ours to judge
        [ "$branch" = "$def" ] && continue  # never sweep the default branch
        if [ "$path" = "$current" ]; then
            skipped+=("$name - you are standing in it")
            continue
        fi
        [ -d "$path" ] || continue          # already gone from disk, prune handles it

        unique=$(git rev-list --count "$defref..$branch" 2>/dev/null) || unique=0

        if upstream_gone "$path" "$branch"; then
            if [ "$unique" -gt 0 ] && [ "$force" -eq 0 ]; then
                skipped+=("$name - upstream gone but has $unique commit(s) not in $def (use -f)")
                continue
            fi
            reason="upstream gone"
        elif [ "$unique" -eq 0 ]; then
            if [ "$(git rev-parse "$branch")" = "$(git rev-parse "$defref")" ]; then
                reason="never diverged from $def"
            else
                reason="merged into $def"
            fi
        else
            continue                        # unique commits and a live upstream: active work
        fi

        if [ "$force" -eq 0 ] && [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
            skipped+=("$name - $reason, but has uncommitted changes (use -f)")
            continue
        fi

        paths+=("$path")
        branches+=("$branch")
        reasons+=("$reason")
    done < <(list_worktrees)

    if [ ${#skipped[@]} -gt 0 ]; then
        echo
        echo "Skipping:"
        for i in "${skipped[@]}"; do
            echo "  ${C_DIM}-${C_OFF} $i"
        done
    fi

    if [ ${#paths[@]} -eq 0 ]; then
        echo
        echo "✨ Nothing to sweep."
        return
    fi

    echo
    echo "These worktrees and their branches would go:"
    for i in "${!paths[@]}"; do
        name=${paths[$i]}
        case "$name" in "$root"/*) name=${name#"$root"/} ;; esac
        printf '  %s %-24s %s\n' "🗑 " "$name" "${C_DIM}${reasons[$i]}${C_OFF}"
    done
    echo

    [ "$dry" -eq 1 ] && return

    if [ "$yes" -eq 0 ]; then
        if [ -t 0 ]; then
            read -r -p "Remove ${#paths[@]} worktree(s)? [y/N] " answer
            case "$answer" in
                y | Y | yes | Yes) ;;
                *)
                    echo "Aborted."
                    return
                    ;;
            esac
        else
            echo "Re-run with -y to remove them."
            return
        fi
    fi

    for i in "${!paths[@]}"; do
        path=${paths[$i]}
        branch=${branches[$i]}
        if [ "$force" -eq 1 ]; then
            git worktree remove --force "$path" || continue
        else
            git worktree remove "$path" || {
                echo "⚠️  Could not remove $path, skipping."
                continue
            }
        fi
        if git branch -D "$branch" >/dev/null 2>&1; then
            echo "✅ $branch"
        else
            echo "⚠️  Removed the worktree but kept branch '$branch'."
        fi
    done

    git worktree prune
}

cmd_path() {
    require_repo
    local name=${1:-} path
    if [ -z "$name" ]; then
        repo_root
        return
    fi
    path=$(worktree_path "$name")
    [ -d "$path" ] || die "No such worktree: $path"
    echo "$path"
}

cmd_editor() {
    local name="" path
    local -a editor

    while [ $# -gt 0 ]; do
        case "$1" in
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for editor." ;;
            *)
                [ -n "$name" ] && die "Unexpected argument '$1'."
                name=$1
                shift
                ;;
        esac
    done
    require_repo

    if [ -n "$name" ]; then
        path=$(worktree_path "$name")
        [ -d "$path" ] || die "No such worktree: $path"
    else
        # The repo root is bare, so --show-toplevel only answers from inside a worktree
        path=$(git rev-parse --show-toplevel 2>/dev/null)
        [ -n "$path" ] || die "Not inside a worktree." \
            "Name one instead: $SCRIPT_NAME editor <worktree>"
    fi

    # Split so WTREE_EDITOR can carry flags, e.g. WTREE_EDITOR="code -n"
    read -r -a editor <<<"${WTREE_EDITOR:-webstorm}"
    [ ${#editor[@]} -gt 0 ] || die "WTREE_EDITOR is empty."
    command -v "${editor[0]}" >/dev/null 2>&1 || die "Editor command '${editor[0]}' not found." \
        "Install it, or set WTREE_EDITOR (e.g. WTREE_EDITOR=\"code -n\")."

    echo "🖥  ${editor[*]} $path"
    "${editor[@]}" "$path"
}

cmd_run() {
    local name="" path

    while [ $# -gt 0 ]; do
        case "$1" in
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for run." "Usage: $SCRIPT_NAME run <worktree> <command...>" ;;
            *)
                name=$1
                shift
                break # the rest is the command, flags and all
                ;;
        esac
    done

    [ -z "$name" ] && die "Missing worktree name." "Usage: $SCRIPT_NAME run <worktree> <command...>"
    [ $# -eq 0 ] && die "Missing command." "Usage: $SCRIPT_NAME run <worktree> <command...>"
    require_repo

    path=$(worktree_path "$name")
    [ -d "$path" ] || die "No such worktree: $path"

    cd "$path" || die "Could not enter $path"
    # Header on stderr so stdout stays exactly what the command produced
    echo "▶️  $* in $path" >&2
    # exec: the command owns the terminal, its exit code becomes ours
    if [ $# -eq 1 ]; then
        # A lone argument may carry shell syntax: run main "npm ci && npm test"
        exec "${SHELL:-/bin/sh}" -c "$1"
    fi
    exec "$@"
}

cmd_agent() {
    local name="" model="$WTREE_MODEL" effort="$WTREE_EFFORT" path
    local -a agent extra=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --model)
                model=${2:-}
                shift
                [ $# -gt 0 ] && shift
                ;;
            --effort)
                effort=${2:-}
                shift
                [ $# -gt 0 ] && shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for agent." "Usage: $SCRIPT_NAME agent <worktree> [args...]" ;;
            *)
                name=$1
                shift
                break # everything after the worktree name belongs to the agent
                ;;
        esac
    done

    [ -z "$name" ] && die "Missing worktree name." "Usage: $SCRIPT_NAME agent <worktree> [args...]"
    require_repo
    path=$(worktree_path "$name")
    [ -d "$path" ] || die "No such worktree: $path"

    # Split so WTREE_AGENT can carry flags, e.g. WTREE_AGENT="claude --dangerously-skip-permissions"
    read -r -a agent <<<"${WTREE_AGENT:-claude}"
    [ ${#agent[@]} -gt 0 ] || die "WTREE_AGENT is empty."
    command -v "${agent[0]}" >/dev/null 2>&1 || die "Agent command '${agent[0]}' not found." \
        "Install it, or set WTREE_AGENT."

    # Skip the default when the same flag was passed through by hand
    [ -n "$model" ] && ! has_arg --model "$@" && extra+=(--model "$model")
    [ -n "$effort" ] && ! has_arg --effort "$@" && extra+=(--effort "$effort")

    echo "🤖 $(printf '%s ' "${agent[@]}" "${extra[@]}")in $path"
    cd "$path" || die "Could not enter $path"
    # exec: the agent owns the terminal from here, signals and exit code included
    exec "${agent[@]}" "${extra[@]}" "$@"
}

# herdr agent names must match [a-z][a-z0-9_-]{0,31}
herdr_name_from() {
    local n
    n=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')
    n=${n#"${n%%[a-z]*}"} # drop anything before the first letter
    [ -z "$n" ] && n="agent"
    printf '%s' "${n:0:32}"
}

# Names have to be unique among live agents, so suffix until one is free
herdr_unique_name() {
    local base=$1 candidate=$1 n=2 taken
    taken=$(herdr agent list 2>/dev/null | jq -r '.result.agents[]?.name // empty')
    while printf '%s\n' "$taken" | grep -qxF "$candidate"; do
        candidate="${base:0:29}-$n"
        n=$((n + 1))
        [ "$n" -gt 99 ] && break
    done
    printf '%s' "$candidate"
}

shell_quote() {
    local s=$1
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

# Idle means nothing but the pane's own shell in the foreground - no command, editor or agent
herdr_pane_idle() {
    herdr pane process-info --pane "$1" 2>/dev/null | jq -e '
        .result.process_info as $p
        | ($p.foreground_processes | length) == 1
          and $p.foreground_processes[0].pid == $p.shell_pid' >/dev/null 2>&1
}

# A fresh pane runs shell startup for a moment; 'agent start' needs it idle at its prompt
herdr_wait_for_prompt() {
    local pane=$1 tries=0
    while [ "$tries" -lt 40 ]; do
        herdr_pane_idle "$pane" && return 0
        sleep 0.25
        tries=$((tries + 1))
    done
    return 1
}

# Another pane in this tab, hosting no agent and sitting at its prompt
herdr_find_free_pane() {
    local pane
    for pane in $(herdr pane list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null |
        jq -r --arg tab "$HERDR_TAB_ID" --arg self "$HERDR_PANE_ID" '
            .result.panes[]?
            | select(.tab_id == $tab and .pane_id != $self and .agent == null)
            | .pane_id'); do
        if herdr_pane_idle "$pane"; then
            printf '%s' "$pane"
            return 0
        fi
    done
    return 1
}

# herdr_start_in_pane <pane> <name> <kind> <path> <cd-first> [agent-args...]
herdr_start_in_pane() {
    local pane=$1 name=$2 kind=$3 path=$4 cd_first=$5 out
    shift 5
    # 'agent start' has no --cwd, so walk the pane's shell there first
    if [ "$cd_first" -eq 1 ]; then
        herdr pane run "$pane" "cd $(shell_quote "$path")" >/dev/null 2>&1 || return 1
    fi
    herdr_wait_for_prompt "$pane" || echo "⚠️  Pane $pane is still busy, trying anyway..."
    # Native agent flags only count after a bare --
    if [ $# -gt 0 ]; then
        out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" -- "$@" 2>&1)
    else
        out=$(herdr agent start "$name" --kind "$kind" --pane "$pane" 2>&1)
    fi || {
        printf '%s\n' "$out" >&2
        return 1
    }
}

cmd_herdr_agent() {
    local name="" agent_name="" kind="claude" direction="" focus="--no-focus" path pane out tries
    local model="$WTREE_MODEL" effort="$WTREE_EFFORT"
    local -a agent_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -n | --name)
                [ -z "$2" ] && die "$1 requires an agent name."
                agent_name=$2
                shift 2
                ;;
            -k | --kind)
                [ -z "$2" ] && die "$1 requires an agent kind."
                kind=$2
                shift 2
                ;;
            --model)
                model=${2:-}
                shift
                [ $# -gt 0 ] && shift
                ;;
            --effort)
                effort=${2:-}
                shift
                [ $# -gt 0 ] && shift
                ;;
            --down)
                direction="down"
                shift
                ;;
            --right)
                direction="right"
                shift
                ;;
            --focus)
                focus="--focus"
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*) die "Unknown option '$1' for herdr-agent." ;;
            *)
                [ -n "$name" ] && die "Unexpected argument '$1'."
                name=$1
                shift
                ;;
        esac
    done

    [ -z "$name" ] && die "Missing worktree name." \
        "Usage: $SCRIPT_NAME herdr-agent <worktree> [-n <name>] [--down|--right]"
    require_repo

    [ "${HERDR_ENV:-}" = "1" ] || die "Not running inside a herdr pane." \
        "Start herdr first, or use '$SCRIPT_NAME agent $name' for a plain terminal."
    command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
    command -v jq >/dev/null 2>&1 || die "herdr-agent needs jq to read herdr's JSON responses."

    path=$(worktree_path "$name")
    [ -d "$path" ] || die "No such worktree: $path"

    [ -z "$agent_name" ] && agent_name=$(herdr_name_from "$name")
    agent_name=$(herdr_unique_name "$agent_name")

    [ -n "$model" ] && agent_args+=(--model "$model")
    [ -n "$effort" ] && agent_args+=(--effort "$effort")

    if [ -z "$direction" ]; then
        # Prefer a pane that is already free rather than displacing what the user is doing
        pane=$(herdr_find_free_pane)
        if [ -n "$pane" ]; then
            echo "🪟 Reusing idle pane $pane in this tab"
            if herdr_start_in_pane "$pane" "$agent_name" "$kind" "$path" 1 "${agent_args[@]}"; then
                [ "$focus" = "--focus" ] && herdr agent focus "$agent_name" >/dev/null 2>&1
                echo "🤖 Agent '$agent_name' ($kind) running in $path"
                echo "   herdr agent prompt $agent_name \"...\""
                return 0
            fi
            echo "⚠️  Could not start the agent in $pane, taking over this pane instead." >&2
        fi

        # Nothing free: 'agent start' cannot target this pane either, since wtree occupies it.
        # Hand the pane straight to the agent and name it once herdr detects it.
        command -v "$kind" >/dev/null 2>&1 || die "Agent command '$kind' not found on PATH." \
            "Pass --down or --right to let herdr start it in a fresh pane instead."
        echo "🤖 $(printf '%s ' "$kind" "${agent_args[@]}")in $path"
        echo "   pane $HERDR_PANE_ID, agent '$agent_name'"
        (
            tries=0
            while [ "$tries" -lt 60 ]; do
                sleep 1
                herdr agent rename "$HERDR_PANE_ID" "$agent_name" >/dev/null 2>&1 && break
                tries=$((tries + 1))
            done
        ) &
        cd "$path" || die "Could not enter $path"
        # OSC 7: the exec'd agent never reports its own cwd, so herdr would keep showing
        # the directory this pane started in
        printf '\033]7;file://%s\033\\' "$path"
        exec "$kind" "${agent_args[@]}"
    fi

    out=$(herdr pane split --current --direction "$direction" --cwd "$path" "$focus" 2>&1) ||
        die "herdr pane split failed." "$out"
    pane=$(printf '%s' "$out" | jq -r '.result.pane.pane_id // empty')
    [ -n "$pane" ] || die "Could not read the new pane id from herdr." "$out"
    echo "🪟 Split $direction -> pane $pane"

    if ! herdr_start_in_pane "$pane" "$agent_name" "$kind" "$path" 0 "${agent_args[@]}"; then
        herdr pane close "$pane" >/dev/null 2>&1
        die "herdr agent start failed (pane $pane closed again)."
    fi

    echo "🤖 Agent '$agent_name' ($kind) running in $path"
    echo "   herdr agent prompt $agent_name \"...\""
}

cmd_prune() {
    require_repo
    git worktree prune "$@"
    echo "✅ Pruned stale worktree metadata."
}

cmd_shell_init() {
    cat <<EOF
# Add to ~/.zshrc or ~/.bashrc:  eval "\$($SCRIPT_NAME shell-init)"
$SCRIPT_NAME() {
    if [ "\$1" = "cd" ]; then
        shift
        local __wtree_dir
        __wtree_dir=\$(command $SCRIPT_NAME path "\$@") || return 1
        cd "\$__wtree_dir" || return 1
    else
        command $SCRIPT_NAME "\$@"
    fi
}
EOF
}

COMMAND=$1
shift 2>/dev/null

case "$COMMAND" in
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    remove | rm) cmd_remove "$@" ;;
    ls | list) cmd_list "$@" ;;
    sync) cmd_sync "$@" ;;
    sweep | clean) cmd_sweep "$@" ;;
    path) cmd_path "$@" ;;
    editor) cmd_editor "$@" ;;
    run) cmd_run "$@" ;;
    agent) cmd_agent "$@" ;;
    herdr-agent) cmd_herdr_agent "$@" ;;
    prune) cmd_prune "$@" ;;
    shell-init) cmd_shell_init ;;
    cd)
        # A child process cannot change your shell's directory - the hook can
        cmd_path "$@"
        echo "ℹ️  To actually jump there, install the shell hook:" >&2
        echo "     eval \"\$($SCRIPT_NAME shell-init)\"   # in ~/.zshrc" >&2
        ;;
    help | -h | --help) usage ;;
    "")
        usage
        exit 1
        ;;
    *)
        echo "❌ Error: Unknown command '$COMMAND'." >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac
